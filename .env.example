# PostgreSQL
POSTGRES_USER=sharedspace
POSTGRES_PASSWORD=sharedspace
POSTGRES_DB=sharedspace
DATABASE_URL=postgres://sharedspace:sharedspace@postgres:5432/sharedspace?sslmode=disable

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# For docker compose use minio:9000.
# For local backend runs use localhost:9000.
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sharedspace

# Auth
JWT_SECRET=change-me-in-production
JWT_TTL=3600
REFRESH_JWT_TTL=2592000

# Server
PORT=8080

# Frontend (React)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
