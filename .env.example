# PostgreSQL
POSTGRES_USER=sharedspace
POSTGRES_PASSWORD=sharedspace
POSTGRES_DB=sharedspace
DATABASE_URL=postgres://sharedspace:sharedspace@postgres:5432/sharedspace?sslmode=disable

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# For docker compose use minio:9000.
# For local backend runs use localhost:9000.
MINIO_PUBLIC_ENDPOINT=localhost:9002
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
MINIO_BUCKET=sharedspace
MINIO_REGION=

# Auth
JWT_SECRET=change-me-in-production
JWT_TTL=3600
REFRESH_JWT_TTL=2592000
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_HOURS=1

# SMTP (leave SMTP_HOST empty to disable email sending in dev)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shared-space.ru
SMTP_FROM_NAME=SharedSpace
SMTP_USE_TLS=true

# Public URL of the frontend (used to build verification/reset links)
APP_URL=http://localhost

# Server
PORT=8080
DOMAIN=shared-space.ru

# Frontend (React)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
